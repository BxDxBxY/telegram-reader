# ─── Доступ к Telegram API ────────────────────────────────────────────────
# Получить на https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Путь к файлу сессии БЕЗ расширения. Создаётся один раз командой `login`.
# Файл .session = ваш ключ от аккаунта. Не коммитить, не пересоздавать зря.
TG_SESSION=sessions/main

# ─── Маскировка под обычный десктоп-клиент ────────────────────────────────
TG_DEVICE_MODEL=Desktop PC
TG_SYSTEM_VERSION=Linux 6.x
TG_APP_VERSION=5.0.1
TG_LANG_CODE=ru
TG_SYSTEM_LANG_CODE=ru

# ─── Бережный режим (анти-бан) ────────────────────────────────────────────
# Пауза между чатами на этапе 2, секунды (равномерно случайная)
TGAUDIT_MIN_DELAY=1.5
TGAUDIT_MAX_DELAY=3.5
# Каждые N чатов — длинная "человеческая" пауза
TGAUDIT_LONG_PAUSE_EVERY=25
TGAUDIT_LONG_PAUSE_MIN=15
TGAUDIT_LONG_PAUSE_MAX=40
# Сколько сообщений тянуть из одного чата (15–30 достаточно)
TGAUDIT_SAMPLE_LIMIT=25
# Максимум чатов за один запуск этапа 2 (дневной бюджет)
TGAUDIT_MAX_CHATS_PER_RUN=150
# Если Telegram просит ждать дольше этого (сек) — останавливаемся, а не сидим сутки
TGAUDIT_FLOOD_WAIT_LIMIT=600

# ─── Пороги эвристики ─────────────────────────────────────────────────────
# Сколько дней без активности считать "мёртвым" чатом
TGAUDIT_DEAD_DAYS=180
TGAUDIT_STALE_DAYS=90

# ─── Пути ─────────────────────────────────────────────────────────────────
TGAUDIT_DB=data/tgaudit.db
TGAUDIT_OUT=out

# ─── Необязательный бесплатный ИИ ─────────────────────────────────────────
# none | groq | gemini | openai-compatible
TGAUDIT_AI_PROVIDER=none
TGAUDIT_AI_KEY=
# groq:   llama-3.3-70b-versatile
# gemini: gemini-2.0-flash
TGAUDIT_AI_MODEL=
TGAUDIT_AI_BASE_URL=
# Сколько чатов отправлять модели за один запрос (10–20)
TGAUDIT_AI_BATCH_SIZE=15
# Отправлять ли личные переписки во внешний ИИ (по умолчанию НЕТ)
TGAUDIT_AI_INCLUDE_DMS=0
